---
interface Props {
  items: { title: string; path: string }[];
}

const { items } = Astro.props;
---

{
  items.length > 1 && (
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <ol>
        {items.map((it, i) => (
          <li>{i < items.length - 1 ? <a href={it.path}>{it.title}</a> : <span aria-current="page">{it.title}</span>}</li>
        ))}
      </ol>
    </nav>
  )
}
